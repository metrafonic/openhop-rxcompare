# Two systems of one receiver each. For more systems, or to compare the radios of a multiradio
# system separately, copy receivers.example.yml to receivers.yml instead — these are then ignored,
# apart from any ${VAR} that file reads from here (a handy place to keep the API keys).

# Node A
A_URL=https://repeater-a.example.com
A_KEY=replace-with-api-key
A_NAME=heltec-v4

# Node B
B_URL=http://192.168.1.50:8000
B_KEY=replace-with-api-key
B_NAME=rak-1w

# Default comparison window (hours) and how often to refresh it (seconds)
HOURS=3
REFRESH_SEC=300
# Ranges offered in the report's nav (hours, comma-separated)
RANGES=1,3,6,12,24,48

# Host port to publish the web app on
LISTEN_PORT=8090
# Set to false if a node uses a self-signed certificate
VERIFY_TLS=true
# Timezone for the report's time axes
TZ=UTC

# Where the neighbours are: positions come from the nodes' /api/gps (manual config or fix) and the
# neighbours' own adverts. Override a radio's position if openHop has none:
#A_LAT=59.9697
#A_LON=10.6414
#B_LAT=
#B_LON=
# Nodes advertise once a day or less: how far back to read adverts for positions (hours), and an
# optional file where adverts accumulate across restarts (the Docker image sets /data/adverts.json)
#ADVERT_LOOKBACK_H=336
#ADVERT_CACHE=./adverts.json
# Map tiles (Leaflet template) and their attribution; MAP_AUTO=1 loads the map without the click
#MAP_TILES=https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png
#MAP_ATTRIB=© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> · <a href="https://opentopomap.org">OpenTopoMap</a> (CC-BY-SA)
#MAP_AUTO=1
# Tiles are shown desaturated so the data carries the colour; MAP_GRAY=0 keeps the tiles' own colours
#MAP_GRAY=0
